    "9 ≈ 5-shape + 4-bomb (weak escort). 10 ≈ 5+5 — the escort is real fire, maybe a straight flush. Pressure where the guard is thin.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "9 ≈ 五张牌型 + 四炸(护航弱)。10 ≈ 5+5——护航是真火力,可能是同花顺。哪里守得薄,就往哪里压。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "9 ≈ 五張牌型 + 四張炸(護航弱)。10 ≈ 5+5——護航是真火力,可能是同花順。挑守備薄弱處下手。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "9枚 ≈ 5枚形＋4枚炸弾（弱い護衛）。10枚 ≈ 5+5――護衛は本物の火力、同花順かもしれない。守りが薄い方を攻めろ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "9 ≈ 5장 형태 + 4장 폭탄(약한 호위). 10 ≈ 5+5 — 호위가 진짜 화력이며 어쩌면 동화순. 경비가 얇은 쪽을 압박하라."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "9 ≈ figura de 5 + bomba de 4 (escolta débil). 10 ≈ 5+5: la escolta es fuego de verdad, quizá una escalera de color. Presiona donde la guardia es fina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "9 ≈ figure de 5 + bombe de 4 (escorte faible). 10 ≈ 5+5 — l'escorte est un vrai feu, peut-être une quinte flush. Pressurise là où la garde est mince."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "9 ≈ 5er-Form + 4er-Bombe (schwacher Begleitschutz). 10 ≈ 5+5 — der Begleitschutz ist echtes Feuer, vielleicht ein Straight Flush. Bedränge dort, wo die Deckung dünn ist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "9 ≈ formação de 5 + bomba de 4 (escolta fraca). 10 ≈ 5+5 — a escolta é fogo de verdade, talvez uma sequência de mesmo naipe. Pressione onde a guarda está fraca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "9 ≈ пятёрочная комбинация + бомба из 4 (слабое прикрытие). 10 ≈ 5+5 — прикрытие настоящий огонь, может, флеш-стрит. Давите там, где защита тонка."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "9 ≈ تشكيلة من 5 + قنبلة من 4 (حراسة ضعيفة). 10 ≈ 5+5 — الحراسة نار حقيقية، ربما فلوش متتالٍ. اضغط حيث يكون الحارس رقيقاً."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "9 ≈ 5-आकार + 4-बम (कमजोर रक्षक)। 10 ≈ 5+5 — रक्षक असली आग है, शायद एक समान-रंग सिलसिला। वहाँ दबाव डालो जहाँ पहरा कमजोर है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "9 ≈ bentuk-5 + bom-4 (pengawal lemah). 10 ≈ 5+5 — pengawalnya api sungguhan, mungkin same-flush straight. Tekan di tempat penjaganya tipis."
          }
        }
      }
    },
    "= 5 + 5 → real fire, respect it": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "= 5 + 5 → 真火力,敬让它"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "= 5 + 5 → 真火力,敬重它"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "= 5 + 5 → 本物の火力、敬意を払え"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "= 5 + 5 → 진짜 화력, 존중하라"
          }
        },
        "es": {
