    "NOW the Ace earns its keep — take the trick!": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在这张A该出力了——拿下这一墩!"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「現在」A 派上用場了——拿下這一墩！"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今こそAが働く――この番を取れ！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 에이스가 제값을 합니다 — 이 판을 가져가세요!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AHORA el As se gana el pan: ¡llévate la baza!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MAINTENANT l'As gagne sa place — prenez le pli !"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JETZT verdient sich das Ass seinen Lohn — nimm den Stich!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "AGORA o Ás faz por merecer — leve a rodada!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ТЕПЕРЬ туз отрабатывает своё — бери взятку!"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الآن يكسب الآص أجره — خذ اللفّة!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब इक्का अपनी कीमत वसूलता है — चाल जीतो!"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "SEKARANG As menebus jasanya — rebut triknya!"
          }
        }
      }
    },
    "Never bid against your own partner — pass and protect his exit.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "千万别跟自己搭档抢牌——不要,护住他出去的路。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "絕不跟自己的隊友搶牌——「不要」，護住他的出口。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の相棒に張り合うな――過(パス)して彼の上がりを守れ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자기 파트너와 절대 경쟁하지 마세요 — 패스하고 그의 출구를 지키세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca pujes contra tu propio compañero: pasa y protege su salida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne surenchérissez jamais contre votre propre partenaire — passez et protégez sa sortie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Biete nie gegen deinen eigenen Partner — passe und schütze seinen Ausstieg."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca dispute contra o seu próprio parceiro — passe e proteja a saída dele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никогда не торгуйся против своего же партнёра — пасуй и защищай его выход."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تزايد أبداً ضد شريكك — مرّر واحمِ خروجه."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने ही साथी के खिलाफ कभी बोली न लगाएँ — पास करें और उसके निकलने की रक्षा करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan pernah bersaing melawan partnermu sendiri — lewat dan lindungi pintu keluarnya."
          }
        }
      }
    },
    "Never bomb a four — except when you must": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绝不为一对四出炸弹——除非不得不炸"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "別拿炸彈炸一對四——除非萬不得已。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4は決して炸弾で割るな――割らざるを得ない時を除いて"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "4 페어에 절대 폭탄 쓰지 마세요 — 꼭 써야 할 때만 빼고"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca bombardees un cuatro, salvo cuando debas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne bombardez jamais une paire de quatre — sauf quand vous le devez"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bombe nie eine Vier weg — außer wenn du musst"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca bombardeie um quatro — exceto quando for obrigado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никогда не бомби четвёрку — кроме случаев, когда придётся"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تُفجِّر قنبلة على لاعب بأربع أوراق — إلا حين تضطر"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चार पर कभी बम न चलाएँ — सिवाय जब मजबूरी हो"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan pernah mengebom pasangan-empat — kecuali saat terpaksa"
          }
        }
      }
    },
