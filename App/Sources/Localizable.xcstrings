          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폭탄, 돌격, 경청 또는 매복"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bombear, cargar, escuchar o emboscar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bombarder, foncer, écouter ou tendre une embuscade"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bomben, stürmen, lauschen oder hinterhalten"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bombear, atacar, ouvir ou emboscar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бомбить, атаковать, слушать или устроить засаду"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فجّر، اندفع، أنصت أو انصب كميناً"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बम, हमला, सुनो या घात"
          }
