          "stringUnit": {
            "state": "translated",
            "value": "そして9が最後に出ていく。頭游だ！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그리고 9가 마지막으로 빠져나간다. 1위!"
