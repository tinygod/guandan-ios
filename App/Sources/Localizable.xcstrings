    "Marco BOMBS a pair of 8s! Perfect — a bomb spent on a feed, not on your partner's exit.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "马可用炸弹炸掉一对8!完美——炸弹用在喂牌上,而不是用在你搭档出去的那一手上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "馬可用炸彈轟掉一對 8！完美——這炸彈花在送牌上，而不是炸你隊友的出口。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マルコが8の対子を炸弾で潰した！完璧――炸弾が餌に使われた、相棒の上がりに対してじゃない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마르코가 8 페어를 폭탄으로 칩니다! 완벽해요 — 파트너의 출구가 아니라 먹이에 폭탄을 쓴 거죠."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Marco BOMBARDEA una pareja de 8! Perfecto: una bomba gastada en una entrega, no en la salida de tu compañero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marco BOMBARDE une paire de 8 ! Parfait — une bombe dépensée sur un appât, pas sur la sortie de votre partenaire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Marco BOMBT ein Paar 8er weg! Perfekt — eine Bombe für eine Vorlage geopfert, nicht für den Ausstieg deines Partners."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marco BOMBARDEIA um par de 8! Perfeito — um bomba gasto num alimento, e não na saída do seu parceiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Марко БОМБИТ пару восьмёрок! Идеально — бомба потрачена на подкормку, а не на выход твоего партнёра."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ماركو يُفجِّر قنبلة على زوج ثمانيات! مثالي — قنبلة أُنفِقت على تغذية، لا على خروج شريكك."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मार्को 8 के जोड़े पर बम चलाता है! बढ़िया — एक बम फीड पर खर्च हुआ, आपके साथी के निकलने पर नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Marco MENGEBOM sepasang kartu 8! Sempurna — bom dipakai untuk umpan, bukan untuk pintu keluar partnermu."
          }
        }
      }
    },
