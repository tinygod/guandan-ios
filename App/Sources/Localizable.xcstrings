    "Online play is on the roadmap. Practice vs bots for now!": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "联机对战已在计划中。眼下先跟电脑练吧!"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "線上對戰已列入規劃。目前先跟機器人練手吧！"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンライン対戦はロードマップにあり。今のところはボット相手に練習しよう！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온라인 플레이는 로드맵에 있어요. 지금은 봇 상대로 연습하세요!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El juego en línea está en la hoja de ruta. ¡Practica contra los bots por ahora!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu en ligne est sur la feuille de route. Pour l'instant, entraînez-vous contre les bots !"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Online-Spiel ist auf der Roadmap. Üb vorerst gegen Bots!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O jogo online está no nosso roteiro. Por enquanto, treine contra os bots!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Онлайн-игра в планах. Пока тренируйся против ботов!"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اللعب عبر الإنترنت ضمن خارطة الطريق. تدرّب ضد الروبوتات في الوقت الحالي!"
          }
