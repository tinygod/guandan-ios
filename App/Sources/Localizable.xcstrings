    "Coach Wu POUNCES — his 6s take it and he's OUT! 🎉": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "教练吴一把扑住——他的6接走了，出完啦！🎉"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "吳教練撲上來了——他的6接住，他出完了！🎉"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コーチ・ウーが飛びつく。彼の6が取り、上がり（OUT）だ！🎉"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "교练 우가 덮칩니다 — 그의 6이 가져가고 그가 아웃! 🎉"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Coach Wu SE LANZA: sus 6 se la llevan y SE QUEDA SIN CARTAS! 🎉"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach Wu BONDIT — ses 6 l'emportent et il a TERMINÉ ! 🎉"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach Wu SCHLÄGT ZU — seine 6er gewinnen und er ist DRAUSSEN! 🎉"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach Wu PARTE PRA CIMA — os 6 dele levam e ele SAIU! 🎉"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach Wu БРОСАЕТСЯ В АТАКУ — его шестёрки забирают взятку, и он ВЫХОДИТ! 🎉"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المدرّب وو ينقضّ — سداسياته تأخذها وهو خارج! 🎉"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोच वू झपट्टा मारते हैं — उनके 6 जीत लेते हैं और वे बाहर! 🎉"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach Wu MENERKAM — 6-nya menang dan dia HABIS! 🎉"
          }
        }
      }
    },
    "Coach Wu can't match it.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "教练吴压不过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "吳教練接不上。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コーチ・ウーは合わせられない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "교练 우는 받아칠 수 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach Wu no puede igualarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach Wu ne peut pas surenchérir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach Wu kann nicht mithalten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Coach Wu não consegue cobrir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach Wu не может это перебить."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المدرّب وو لا يستطيع مجاراتها."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोच वू इसका मुक़ाबला नहीं कर सकते।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach Wu tak bisa menandinginya."
          }
        }
      }
    },
    "Coach Wu fires back Queens — he's fighting for your team!": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "教练吴回敬一对Q——他在为你的队伍而战！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "吳教練反手甩出一對Q——他在為你的隊伍而戰！"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コーチ・ウーがQで撃ち返す。あなたのチームのために戦っている！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "교练 우가 퀸으로 반격합니다 — 당신 팀을 위해 싸우고 있어요!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach Wu contraataca con Reinas: ¡está peleando por tu equipo!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach Wu riposte avec des Dames — il se bat pour votre équipe !"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach Wu kontert mit Damen — er kämpft für dein Team!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Coach Wu rebate com Damas — ele está lutando pela sua equipe!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach Wu отвечает дамами — он бьётся за твою команду!"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المدرّب وو يردّ بالبنات — إنه يقاتل من أجل فريقك!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोच वू क्वीन से जवाबी फायर करते हैं — वे आपकी टीम के लिए लड़ रहे हैं!"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach Wu balas dengan Q — dia berjuang untuk timmu!"
          }
        }
      }
    },
    "Coach Wu kept exactly TWO cards all hand. He answered pairs eagerly and ignored every single — he's been telling you all along: MY LAST TWO ARE A PAIR.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "教练吴整手牌一直只留着两张。对子他抢着接，单张却一概不理——他从头到尾都在告诉你：我最后两张是一对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "吳教練整手牌就死死留著兩張。他見對子就積極應，見單張就全不理——他一直在告訴你：我最後兩張是一對。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コーチ・ウーは手の最後まできっかり2枚を残していました。対子には積極的に応じ、単張はすべて無視した。彼はずっとこう告げていたのです。「俺の最後の2枚は対子だ」と。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "교练 우는 한 판 내내 정확히 두 장을 남겼습니다. 페어에는 적극적으로 응수하고 단장은 전부 무시했죠 — 줄곧 당신에게 말하고 있던 겁니다: 내 마지막 두 장은 페어다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach Wu se quedó con exactamente DOS cartas toda la mano. Respondió a las parejas con ganas e ignoró cada single: te lo ha estado diciendo todo el tiempo: MIS DOS ÚLTIMAS SON UNA PAREJA."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach Wu a gardé exactement DEUX cartes toute la main. Il a répondu aux paires avec empressement et ignoré chaque single — il vous le disait depuis le début : MES DEUX DERNIÈRES SONT UNE PAIRE."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach Wu hat das ganze Blatt über genau ZWEI Karten behalten. Er hat eifrig auf Paare geantwortet und jede Einzelkarte ignoriert — er hat es dir die ganze Zeit gesagt: MEINE LETZTEN ZWEI SIND EIN PAAR."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Coach Wu manteve exatamente DUAS cartas a mão toda. Ele respondeu aos pares com vontade e ignorou todo single — ele esteve te avisando o tempo todo: MINHAS DUAS ÚLTIMAS SÃO UM PAR."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach Wu всю раздачу держал ровно ДВЕ карты. Он охотно отвечал на пары и игнорировал каждый одиночку — он всё это время тебе говорил: МОИ ПОСЛЕДНИЕ ДВЕ — ЭТО ПАРА."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المدرّب وو احتفظ ببطاقتين بالضبط طوال الجولة. لقد ردّ على الأزواج بحماس وتجاهل كل فردية — لقد كان يخبرك طوال الوقت: آخر بطاقتين لديّ زوج."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोच वू ने पूरे हाथ में ठीक दो पत्ते रखे। वे जोड़ों का बेसब्री से जवाब देते रहे और हर सिंगल को नज़रअंदाज़ करते रहे — वे शुरू से ही आपको बता रहे थे: मेरे आखिरी दो एक जोड़ा हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach Wu menyimpan tepat DUA kartu sepanjang ronde. Dia menanggapi pasangan dengan semangat dan mengabaikan setiap kartu tunggal — sejak tadi dia memberitahumu: DUA KARTU TERAKHIRKU ADALAH PASANGAN."
          }
        }
      }
    },
    "Coach Wu passes. Partners don't fight each other.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "教练吴选择不要。队友之间不互相压牌。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "吳教練不要。隊友不會自己人打自己人。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コーチ・ウーはパス。味方同士は争わない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "교练 우가 패스합니다. 파트너끼리는 서로 싸우지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach Wu pasa. Los compañeros no se pelean entre sí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach Wu passe. Les partenaires ne se battent pas entre eux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach Wu passt. Partner kämpfen nicht gegeneinander."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Coach Wu passa. Parceiros não brigam entre si."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach Wu пасует. Партнёры не воюют друг с другом."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المدرّب وو يمرّر. الشركاء لا يتقاتلون."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोच वू पास करते हैं। साथी आपस में नहीं लड़ते।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach Wu pas. Pasangan tak saling melawan."
          }
        }
      }
    },
    "Coach Wu strengthens the team's grip with 10s.": {
