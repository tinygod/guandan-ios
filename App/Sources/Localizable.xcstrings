    "Any PAIR — their single can never follow it": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任意对子——他们的单张永远跟不上"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任意一個對子——他們的單張永遠跟不上"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どんな対子でも――相手の単張は絶対に続けられない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 대자든 — 그들의 단장은 결코 따라올 수 없다"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquier PAREJA: su suelta nunca podrá seguirla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'importe quelle PAIRE — leur single ne pourra jamais la suivre"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Irgendein PAAR — ihre Einzelkarte kann nie darauf folgen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer PAR — a avulsa deles nunca consegue acompanhar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Любая ПАРА — их одиночная за ней никогда не пойдёт"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أي زوج — مفردتهم لا تستطيع متابعته أبداً"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई भी जोड़ा — उनकी इकाई कभी इसका पीछा नहीं कर सकती"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair apa pun — single mereka tak akan pernah bisa mengikutinya"
          }
        }
      }
    },
