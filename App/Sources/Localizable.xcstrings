    "No answers.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没人接得上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無人能接。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "応じる者なし。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받을 게 없어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin respuestas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune réponse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Antworten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem respostas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет ответов."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا ردود."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई जवाब नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak ada jawaban."
          }
        }
      }
    },
    "No bomb, one Ace pair, and a swamp of dead smalls — barely 2 points. A pro doesn't fight this: block enemies, feed your partner, take the assist.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没炸弹,一对A,外加一摊死掉的小牌——勉强2分。高手不会硬拼这副:封住敌人、喂牌给搭档、拿个助攻。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有炸彈、一對 A、外加一灘死掉的小牌——勉強 2 分。高手不會去硬拼這手：擋敵、餵隊友、拿助攻。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "炸弾なし、Aの対子が一組、そして死んだ小札の沼――かろうじて2点。プロはこれで戦わない：敵をブロックし、相棒に餌をやり、助攻を取る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폭탄도 없고, 에이스 페어 하나에, 죽은 작은 카드 늪뿐 — 겨우 2점입니다. 프로는 이런 패로 싸우지 않아요: 적을 막고, 파트너에게 먹이를 주고, 어시스트를 챙기세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin bomba, una pareja de Ases y un pantano de cartas bajas muertas: apenas 2 puntos. Un profesional no pelea esto: bloquea a los enemigos, alimenta a tu compañero, llévate la asistencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de bombe, une paire d'As, et un marécage de petites cartes mortes — à peine 2 points. Un pro ne se bat pas là-dessus : bloquez les ennemis, nourrissez votre partenaire, prenez l'assist."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Bombe, ein Ass-Paar und ein Sumpf aus toten kleinen Karten — kaum 2 Punkte. Ein Profi kämpft damit nicht: Blockiere Gegner, füttere deinen Partner, kassiere den Assist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem bomba, um par de Ases e um pântano de cartas baixas mortas — mal chega a 2 pontos. Um profissional não briga por isso: bloqueia os inimigos, alimenta o parceiro, fica com a assistência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни бомбы, одна пара тузов и болото мёртвой мелочи — едва ли 2 очка. Профи за это не бьётся: блокируй врагов, корми партнёра, бери ассист."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا قنبلة، زوج آصات واحد، ومستنقع من الأوراق الصغيرة الميتة — نقطتان بالكاد. المحترف لا يقاتل هذه: احجب الأعداء، غذِّ شريكك، خذ التمريرة الحاسمة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई बम नहीं, इक्के का एक जोड़ा, और मरे हुए छोटे पत्तों का दलदल — मुश्किल से 2 अंक। एक माहिर खिलाड़ी इससे नहीं लड़ता: दुश्मनों को रोकें, अपने साथी को फीड करें, सहायक की भूमिका लें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak ada bom, satu pasangan As, dan rawa kartu kecil mati — nyaris 2 poin. Pemain pro tak melawan ini: blokir lawan, umpani partnermu, ambil peran asis."
          }
        }
      }
    },
    "No exit after bombing": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "炸完没了后路"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "炸完後無路可走。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "炸弾を切った後に上がり札がない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폭탄 친 뒤 출구가 없음"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin salida tras bombardear"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune sortie après avoir bombardé"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Ausstieg nach dem Bomben"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem saída depois de bombardear"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет выхода после бомбы"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا مخرج بعد التفجير"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बम चलाने के बाद कोई निकास नहीं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak ada pintu keluar setelah mengebom"
          }
        }
      }
    },
    "No — a small joker and 8s are still hiding out there": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不安全——外面还藏着一张小王和几张8"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不能——還有一張小王和幾張 8 藏在外面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いや――小王と8がまだ外に隠れている"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아니요 — 작은 조커 하나와 8들이 아직 밖에 숨어 있어요"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No: un comodín pequeño y los 8 siguen escondidos por ahí"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non — un petit joker et des 8 se cachent encore là-dehors"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nein — ein kleiner Joker und 8er lauern noch da draußen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não — um coringa pequeno e os 8 ainda estão escondidos por aí"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет — маленький джокер и восьмёрки всё ещё прячутся там"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا — لا يزال جوكر صغير وثمانيات يختبئان هناك"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नहीं — एक छोटा जोकर और 8 अब भी वहाँ छिपे हैं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak — satu joker kecil dan kartu-kartu 8 masih bersembunyi di luar sana"
          }
        }
      }
    },
    "No — flip every rule: now you WANT to arm them": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不安全——把所有规则反过来:现在你反而\"想\"给他们送弹药"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不能——把每條規則都反過來：現在你「希望」武裝他們。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いや――すべてのルールをひっくり返せ：今は相手を武装させたいんだ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아니요 — 모든 규칙을 뒤집으세요: 이제 상대를 무장시켜야 합니다"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No: invierte todas las reglas, ahora SÍ quieres armarlos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non — inversez chaque règle : maintenant vous VOULEZ les armer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nein — kehr jede Regel um: Jetzt WILLST du sie bewaffnen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não — inverta todas as regras: agora você QUER armá-los"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет — переверни каждое правило: теперь ты ХОЧЕШЬ их вооружить"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا — اقلب كل قاعدة: الآن أنت تريد تسليحهم"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नहीं — हर नियम उलट दें: अब आप उन्हें हथियारबंद करना चाहते हैं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak — balikkan setiap aturan: sekarang kamu MAU mempersenjatai mereka"
          }
        }
      }
    },
    "Nobody answers a bomb cheaply. The lead is yours.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没人会拿好牌去接炸弹。出牌权是你的了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒人會輕易去接一個炸彈。出牌權歸你。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "炸弾に安く応じる者はいない。首攻は君のものだ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폭탄을 싸게 받는 사람은 없습니다. 출패권은 당신 겁니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie responde a una bomba barata. La salida es tuya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne ne répond à une bombe à bas prix. L'initiative est à vous."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemand kontert eine Bombe billig. Du spielst an."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém responde a um bomba de graça. A liderança é sua."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никто не отвечает на бомбу задёшево. Ход твой."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا أحد يردّ على قنبلة بثمن بخس. القيادة لك."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई बम का सस्ते में जवाब नहीं देता। चाल आपकी है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak ada yang membalas bom dengan murah. Pimpinan jadi milikmu."
          }
        }
      }
    },
    "Nobody answers. And since the trick-winner is out — you catch the wind.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没人接得上。又因为赢墩的人已经出去了——你接风。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無人接牌。而且由於贏墩的人已經走了——換你接風。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "応じる者なし。そして番を取った者が上がったから――君が接風する。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무도 받지 못합니다. 그리고 이 판을 이긴 사람이 이미 나갔으니 — 당신이 접풍을 받습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie responde. Y como quien ganó la baza ya salió, recibes el viento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne ne répond. Et comme le gagnant du pli est sorti — vous prenez le vent (接风)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemand antwortet. Und da der Stichgewinner draußen ist — du fängst den Wind auf."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém responde. E como quem venceu a rodada saiu — você pega a brisa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никто не отвечает. А раз победитель взятки вышел — ты ловишь ветер."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا أحد يرد. وبما أن الفائز باللفّة قد خرج — فأنت تلتقط الريح."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई जवाब नहीं देता। और चूँकि चाल जीतने वाला बाहर है — आप हवा पकड़ लेते हैं (आपकी बारी आ जाती है)।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak ada yang membalas. Dan karena pemenang trik sudah keluar — kamu menyambut angin (jiē fēng)."
          }
        }
      }
    },
    "Nobody fights for a small trick.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没人会为一墩小牌去争。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒人會為了一個小墩去爭。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さな番のために誰も争わない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 판을 두고 싸우는 사람은 없어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie pelea por una baza pequeña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne ne se bat pour un petit pli."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemand kämpft um einen kleinen Stich."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém briga por uma rodada pequena."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никто не бьётся за мелкую взятку."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا أحد يقاتل على لفّة صغيرة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छोटी चाल के लिए कोई नहीं लड़ता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak ada yang memperebutkan trik kecil."
          }
        }
      }
    },
    "Nobody fights. Marco's trick.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没人争。这墩是马可的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒人爭。這墩歸馬可。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰も争わない。マルコの番だ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무도 안 싸웁니다. 마르코의 판이에요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie pelea. Baza de Marco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne ne se bat. Le pli est à Marco."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemand kämpft. Marcos Stich."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém briga. Rodada do Marco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никто не бьётся. Взятка Марко."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا أحد يقاتل. اللفّة لماركو."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई नहीं लड़ता। मार्को की चाल।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak ada yang melawan. Trik milik Marco."
          }
        }
      }
    },
    "Nobody tracks 108 cards. Track FOUR things: the 2 big jokers, the 2 small jokers, the 8 level cards, and every bomb that explodes. That's it.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没人记得住108张牌。只记四样东西:2张大王、2张小王、8张级牌,还有每个炸响的炸弹。就这些。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒人記得住 108 張牌。只追蹤「四」樣東西：2 張大王、2 張小王、8 張級牌，以及每一個炸過的炸彈。就這些。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰も108枚を数えきれない。4つのことだけ追え：大王2枚、小王2枚、級牌8枚、そして爆発したすべての炸弾。それだけだ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "108장을 다 추적하는 사람은 없습니다. 네 가지만 추적하세요: 큰 조커 2장, 작은 조커 2장, 급수패 8장, 그리고 터진 모든 폭탄. 그게 전부예요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie sigue las 108 cartas. Sigue CUATRO cosas: los 2 comodines grandes, los 2 comodines pequeños, las 8 cartas de nivel y cada bomba que estalla. Eso es todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne ne suit les 108 cartes. Suivez QUATRE choses : les 2 grands jokers, les 2 petits jokers, les 8 cartes de niveau, et chaque bombe qui explose. C'est tout."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemand verfolgt 108 Karten. Verfolge VIER Dinge: die 2 großen Joker, die 2 kleinen Joker, die 8 Stufenkarten und jede Bombe, die hochgeht. Das war's."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém rastreia 108 cartas. Rastreie QUATRO coisas: os 2 coringas grandes, os 2 coringas pequenos, as 8 cartas de nível e cada bomba que explode. Só isso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никто не считает 108 карт. Отслеживай ЧЕТЫРЕ вещи: 2 больших джокера, 2 маленьких джокера, 8 карт уровня и каждую взорвавшуюся бомбу. Вот и всё."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا أحد يتعقّب 108 أوراق. تعقّب أربعة أشياء: الجوكرين الكبيرين، الجوكرين الصغيرين، أوراق المستوى الثماني، وكل قنبلة تنفجر. هذا كل شيء."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई 108 पत्तों का हिसाब नहीं रखता। चार चीज़ों पर नज़र रखें: 2 बड़े जोकर, 2 छोटे जोकर, 8 लेवल पत्ते, और हर बम जो फटता है। बस इतना ही।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak seorang pun melacak 108 kartu. Lacak EMPAT hal: 2 joker besar, 2 joker kecil, 8 kartu level, dan setiap bom yang meledak. Hanya itu."
          }
        }
      }
    },
