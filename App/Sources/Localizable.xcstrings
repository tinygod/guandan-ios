    "Controller — the ambush is sprung; expect a clean exit behind it": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制型——伏击已经发动；预料他随后会干干净净地走牌出完"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "控制型——埋伏已經發動；料想牠後面還跟著一手乾淨的出完牌"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コントローラー型、待ち伏せが発動した。後ろにきれいな上がりが控えていると見るべし"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컨트롤러 — 매복이 발동됐습니다; 그 뒤로 깔끔한 탈출이 따라올 겁니다"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlador: la emboscada ya saltó; espera una salida limpia detrás de ella"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôleur — l'embuscade est déclenchée ; attendez-vous à une sortie nette derrière"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrolleur — der Hinterhalt ist losgegangen; erwarte einen sauberen Ausstieg dahinter"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlador — a emboscada foi disparada; espere uma saída limpa logo atrás"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контролёр — засада сработала; жди за ней чистого выхода"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متحكّم — انطلق الكمين؛ توقّع خروجاً نظيفاً خلفه"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कंट्रोलर — घात लग चुका है; इसके पीछे एक साफ़ निकासी की उम्मीद रखें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengendali — sergapan sudah dilepaskan; siapkan diri untuk jalan keluar mulus setelahnya"
          }
        }
      }
    },
    "Controllers vs chargers": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制型 vs 强攻型"
          }
        },
        "zh-Hant": {
