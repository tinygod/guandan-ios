          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجموعتا أوراق، أربعة لاعبين"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दो गड्डियाँ, चार खिलाड़ी"
          }
        },
        "id": {
