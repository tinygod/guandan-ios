        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑनलाइन खेल रोडमैप में है। फिलहाल बॉट के खिलाफ अभ्यास करें!"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permainan online ada dalam rencana ke depan. Untuk sekarang, berlatihlah melawan bot!"
          }
        }
      }
    },
