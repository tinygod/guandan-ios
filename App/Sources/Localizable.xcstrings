    "Make them burn their fire": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逼他们烧掉火力"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "逼他們燒掉火力。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手に火力を焼かせろ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대가 화력을 태우게 만드세요"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazlos quemar su fuego"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites-les brûler leur puissance de feu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring sie dazu, ihr Feuer zu verbrennen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça-os queimar o poder de fogo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заставь их сжечь свой огонь"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجعلهم يحرقون نارهم"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उन्हें अपनी आग जलाने पर मजबूर करें"
