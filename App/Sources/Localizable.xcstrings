    "Trick won — you lead again. Time to dump everything.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一墩赢了——又轮到你出牌。是时候把牌全甩出去了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "贏下這墩——你重新首攻。是時候把牌全甩出去了。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トリック獲得——再び君の出番だ。すべてを吐き出す時だ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "판을 이겼습니다 — 다시 당신이 선공입니다. 모든 걸 털어낼 시간입니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baza ganada: lideras de nuevo. Hora de soltar todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pli gagné — c'est encore à toi d'ouvrir. Le moment de tout lâcher."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stich gewonnen – du spielst wieder an. Zeit, alles abzuwerfen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rodada ganha — você lidera de novo. Hora de descarregar tudo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Взятка взята — ходишь снова. Пора сбрасывать всё."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ربحت الجولة — الدور لك من جديد. حان وقت التخلّص من كل شيء."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चाल जीती — तुम फिर चलोगे। अब सब कुछ झाड़ देने का वक़्त है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Trik dimenangkan — kamu memimpin lagi. Saatnya buang semuanya."
          }
        }
      }
    },
    "Trick yours — now sequence the exit.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一墩是你的——现在排好退出的顺序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這墩歸你——現在排好出牌的順序。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トリックは君のもの——さあ上がりの順番を組め。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "판은 당신 것 — 이제 탈출 순서를 짜세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La baza es tuya: ahora ordena la salida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pli à toi — enchaîne maintenant la sortie dans l'ordre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stich gehört dir – jetzt ordne den Ausstieg."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rodada sua — agora sequencie a saída."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Взятка твоя — теперь выстрой порядок выхода."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجولة لك — الآن رتّب خطوات الخروج."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चाल तुम्हारी — अब निकलने का क्रम तय करो।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Trik milikmu — sekarang susun urutan jalan keluarnya."
          }
        }
      }
    },
