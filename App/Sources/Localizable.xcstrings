          }
        }
      }
    },
    "Done — and thanks to 接风…": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搞定——还得谢谢接风……"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "出完了——多虧了接風……"
          }
        },
