    "Lena answers with two 9s. A pair can only be beaten by a higher pair.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "莉娜用一对9回应。对子只能被更大的对子压过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "蕾娜回了一對 9。對子只能被更大的對子壓過。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レナは9を2枚で応じる。対子はより高い対子でしか倒せない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레나가 9 두 장으로 받습니다. 페어는 더 높은 페어로만 잡을 수 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lena responde con dos 9. Una pareja solo la supera otra pareja más alta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lena répond avec deux 9. Une paire ne peut être battue que par une paire plus forte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lena antwortet mit zwei 9ern. Ein Paar lässt sich nur von einem höheren Paar schlagen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lena responde com dois 9. Um par só pode ser vencido por um par maior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лена отвечает двумя девятками. Пару можно перебить только старшей парой."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترد لينا بتسعتين. لا يُهزَم الزوج إلا بزوج أعلى."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लीना दो 9 के साथ जवाब देती है। एक जोड़े को सिर्फ ऊँचा जोड़ा ही हरा सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lena membalas dengan dua kartu 9. Pasangan hanya bisa dikalahkan oleh pasangan yang lebih tinggi."
          }
        }
      }
    },
    "Lena bumps it with 9s — she smells danger.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "莉娜用对9顶上来——她嗅到了危险。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "蕾娜用 9 頂上——她嗅到了危險。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レナは9でかぶせてくる――危険を嗅ぎ取ったんだ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레나가 9들로 받아칩니다 — 위험을 직감한 거죠."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lena lo sube con 9: huele el peligro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lena la relance avec des 9 — elle flaire le danger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lena kontert mit 9ern — sie wittert Gefahr."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lena cobre com 9 — ela sente o perigo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лена перебивает девятками — она чует опасность."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصدّها لينا بالتسعات — إنها تشمّ الخطر."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लीना 9 से इसे बढ़ा देती है — उसे खतरे की बू आ रही है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lena menaikkannya dengan kartu 9 — dia mencium bahaya."
          }
        }
      }
    },
    "Lena can only watch…": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "莉娜只能干看着……"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "蕾娜只能乾瞪眼……"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レナは見ているしかない…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레나는 지켜볼 수밖에 없어요…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lena solo puede mirar..."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lena ne peut que regarder…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lena kann nur zusehen …"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lena só pode assistir…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лене остаётся только смотреть…"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تملك لينا إلا أن تشاهد…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लीना सिर्फ देख सकती है…"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lena hanya bisa menonton…"
          }
        }
      }
    },
    "Lena grabs it with a Queen…": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "莉娜用一张Q接住了……"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "蕾娜用一張 Q 接走……"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レナはクイーンで取りに来る…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레나가 퀸으로 가져갑니다…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lena la atrapa con una Reina..."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lena la rafle avec une Dame…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lena schnappt es sich mit einer Dame …"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lena fica com a rodada usando uma Dama…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лена забирает её дамой…"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تخطفها لينا بملكة…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लीना एक रानी से इसे पकड़ लेती है…"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lena merebutnya dengan satu Ratu…"
          }
        }
      }
    },
    "Lena leads a single 7. Only a higher single answers it.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "莉娜出一张单7。只有更大的单张才接得住。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "蕾娜出單張 7。只有更大的單張才接得住。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レナが単張の7を首攻する。より高い単張でしか応じられない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레나가 단장 7을 냅니다. 더 높은 단장만이 이걸 받을 수 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lena saca un 7 suelto. Solo una carta suelta más alta lo responde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lena mène un 7 isolé. Seul un single plus haut peut y répondre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lena spielt eine einzelne 7 an. Nur eine höhere Einzelkarte schlägt sie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lena lidera com um 7 único. Só uma carta única maior responde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лена ходит одиночной семёркой. Ответить может только старшая одиночка."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقود لينا بسبعة مفردة. لا يردّها إلا مفردة أعلى."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लीना एक एकल 7 चलती है। सिर्फ एक ऊँचा एकल पत्ता ही इसका जवाब दे सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lena memimpin dengan satu kartu 7. Hanya kartu tunggal lebih tinggi yang bisa membalas."
          }
        }
      }
    },
