    "Feed him: a tiny pair — a gift only your partner can want.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "喂他:一对小牌——这份礼只有你搭子会想要。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "餵他：一對小牌——一份只有你隊友會想要的禮物。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "彼に供給だ。小さな対子、相棒だけが欲しがる贈り物。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그에게 먹이세요: 작은 페어 — 오직 당신의 파트너만이 원할 수 있는 선물입니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aliméntalo: una parejita, un regalo que solo tu compañero puede querer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nourrissez-le : une toute petite paire — un cadeau que seul votre partenaire peut désirer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füttere ihn: ein winziges Paar — ein Geschenk, das nur dein Partner wollen kann."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abasteça-o: um par minúsculo — um presente que só o seu parceiro pode querer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покорми его: крошечная пара — подарок, который нужен только твоему партнёру."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غذِّه: زوج صغير — هدية لا يريدها سوى شريكك."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उसे खिलाएँ: एक नन्हा जोड़ा — एक ऐसा तोहफ़ा जो सिर्फ़ आपका साथी चाह सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri dia makan: pasangan mungil — hadiah yang hanya pasanganmu yang mau."
          }
        }
      }
    },
    "Feed your partner, never fight them": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "喂你的搭子,绝不和他互压"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "餵你的隊友，絕不跟他較勁"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相棒には供給し、決して争わない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파트너에게 먹이고, 절대 싸우지 마세요"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alimenta a tu compañero, nunca lo pelees"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nourrissez votre partenaire, ne le combattez jamais"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füttere deinen Partner, kämpfe nie gegen ihn"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abasteça seu parceiro, nunca brigue com ele"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Корми партнёра, никогда не воюй с ним"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غذِّ شريكك، ولا تقاتله أبداً"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने साथी को खिलाएँ, उससे कभी न लड़ें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri makan pasanganmu, jangan pernah melawannya"
          }
        }
      }
    },
