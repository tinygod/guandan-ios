    },
    "Anti-tribute! The losers hold both big jokers.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抗贡!输家手握两张大王。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "抗貢!輸家手握兩張大王。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "進貢拒否！ 負け側が大ジョーカー2枚を握っている。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진공 거부! 진 쪽이 큰 조커 두 장을 들고 있다."
