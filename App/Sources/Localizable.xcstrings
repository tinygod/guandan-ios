    "Pass — and feel how little it costs.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择不要 — 感受一下它的代价有多小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇不要 — 感受一下這幾乎不花你什麼代價。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスする — その代償がいかに小さいか感じてみよう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패스 — 그게 얼마나 손해가 적은지 느껴보세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa — y nota lo poco que cuesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe — et vois à quel point ça coûte peu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe — und spüre, wie wenig es kostet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe — e sinta como custa pouco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пасуй — и почувствуй, как мало это стоит."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرّر — واشعر كم أن ثمن ذلك زهيد."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पास करो — और महसूस करो कि इसकी कीमत कितनी कम है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas — dan rasakan betapa kecil ongkosnya."
          }
        }
      }
    },
