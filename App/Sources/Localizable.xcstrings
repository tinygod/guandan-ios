    "Beat it with the Jack — never spend more than the trick needs.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用J压过去就行——绝不为一墩花超过它所需的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 J 壓過去——花費永遠不要超過這一墩所需。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジャックで打ち破れ――一巡に必要な以上は絶対に使うな。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잭으로 이겨라 — 트릭에 필요한 것 이상 쓰지 마라."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Véncela con la Jota: nunca gastes más de lo que la baza necesita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bats-le avec le Valet — ne dépense jamais plus que ce que le pli exige."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlag es mit dem Buben — gib nie mehr aus, als der Stich braucht."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Supere com o Valete — nunca gaste mais do que a rodada exige."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перебейте валетом — никогда не тратьте больше, чем требует взятка."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اهزمها بالـ شاب — لا تنفق أبداً أكثر مما تتطلبه الجولة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे गुलाम से हराओ — ट्रिक की ज़रूरत से ज़्यादा कभी खर्च मत करो।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalahkan dengan Jack — jangan pernah belanja lebih dari yang dibutuhkan trik."
          }
        }
      }
    },
    "Beating is optional — passing is a weapon": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "盖牌是选项——不要才是武器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "壓牌是可選項——不要才是武器"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "打ち破るのは任意――パスは武器だ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이기는 건 선택 — 패스는 무기다"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
