        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وورقتك الأخيرة — خرجت أولاً من جديد!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "और तुम्हारा आखिरी कार्ड — फिर से सबसे पहले बाहर!"
