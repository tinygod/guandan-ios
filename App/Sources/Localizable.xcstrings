    "BOOM — Coach Wu slams his last two cards: Kings! He's out FIRST.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轰——吴教练拍下他最后两张牌:一对K!他头游出完。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轟——吳教練拍下他最後兩張牌:一對 K!他第一個出完。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドカン――呉コーチが最後の2枚を叩きつける：キング！ 彼が頭游で上がりだ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쾅 — 우 코치가 마지막 두 장을 내리친다: 킹! 그가 1등으로 아웃."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡BUM! El Entrenador Wu estampa sus dos últimas cartas: ¡Reyes! Sale el PRIMERO."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "BOUM — le coach Wu abat ses deux dernières cartes : des Rois ! Il sort PREMIER."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BUMM — Coach Wu knallt seine letzten zwei Karten hin: Könige! Er ist als ERSTER raus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "BUM — o Treinador Wu joga suas duas últimas cartas: Reis! Ele sai em PRIMEIRO."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "БУМ — тренер У хлопает двумя последними картами: короли! Он выходит ПЕРВЫМ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بوم — يصفع المدرب وو ورقتيه الأخيرتين: ملِكان! خرج أولاً."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धमाका — कोच वू अपने आखिरी दो कार्ड पटकते हैं: बादशाह! वह सबसे पहले बाहर।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "DOR — Coach Wu membanting dua kartu terakhirnya: King! Ia keluar PERTAMA."
          }
        }
      }
    },
