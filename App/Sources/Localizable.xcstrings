    "…the free lead is yours. Out — a DOUBLE finish.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "……自由出牌权归你了。出完——双下收官。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "……自由出牌權歸你。出完——雙下收場。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "…フリーの首攻はあなたのもの。上がり——ダブルでフィニッシュ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "…공짜 출 차례가 당신 것이에요. 나감 — 더블로 마무리."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "…el ataque libre es tuyo. Fuera: un final DOBLE."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "…l'entame libre est à toi. Dehors — une finition en DOUBLE."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "…die freie Eröffnung gehört dir. Raus — ein DOPPELSIEG."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "…a saída livre é sua. Fora — final em DUPLA."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "…свободный заход твой. Вышел — ДАБЛ-финиш."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "…الافتتاحية الحرة لك. خارج — إنهاء مزدوج."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "…मुफ्त लीड आपकी है। बाहर — एक डबल फिनिश।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "…pimpinan gratis jadi milikmu. Keluar — finis DOUBLE."
          }
        }
      }
    },
