          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beres — dan berkat 接风…"
          }
        }
      }
    },
    "Drop the big joker — force their hand.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "甩出大王——逼他亮牌。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
