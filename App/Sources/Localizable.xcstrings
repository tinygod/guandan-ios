    "Smile and pass. The board is now BLOCKER-FREE.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "微微一笑,选择不要。现在牌面上已经没有任何拦路牌了。"
