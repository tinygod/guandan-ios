    "Spend it freely — it wins any pair trick AND returns the lead": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尽管放手用 — 它能压下任何对子,还能把出牌权抢回来"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "盡管放手去用 — 它能贏下任何對子墩，還能拿回出牌權"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "惜しまず使え — どんなペアのトリックにも勝ち、しかも首攻権が戻ってくる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거리낌 없이 쓰세요 — 어떤 페어 트릭이든 이기고 주도권까지 돌려받습니다"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gástala sin reparos — gana cualquier baza de pareja Y devuelve el mando"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dépense-la sans hésiter — elle remporte n'importe quel pli en paire ET te rend la main"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setz es bedenkenlos ein — es gewinnt jeden Paar-Stich UND holt den Anspielzug zurück"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaste à vontade — ganha qualquer vaza de par E devolve a liderança"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Трать смело — она бьёт любую парную взятку И возвращает ход"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنفقها بحرية — تفوز بأي ضربة زوج وتعيد لك القيادة"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे खुलकर ख़र्च करो — यह किसी भी जोड़ी की चाल जीतता है और साथ में चाल भी लौटा देता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Habiskan dengan bebas — ia memenangkan trik pasangan apa pun DAN mengembalikan giliran membuka"
          }
        }
      }
    },
    "Spend the free lead: Jacks.": {
