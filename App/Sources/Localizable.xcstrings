    "His pair stands. Obviously, pass.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "他这对子立住了。明摆着,不要。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "他的對子壓著。顯然，不要。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "彼の対子が通る。当然、パス。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그의 페어가 이깁니다. 당연히, 패스."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su pareja se impone. Obviamente, pasa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa paire tient. Évidemment, passez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sein Paar steht. Offensichtlich: passen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O par dele se mantém. Óbvio, passe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его пара держится. Очевидно, пас."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "زوجه قائم. بديهي، مرّر."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उसका जोड़ा टिका रहता है। ज़ाहिर है, पास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasangannya unggul. Jelas, pas."
          }
        }
      }
    },
