    "I'd PASS here — no need to spend cards on this trick.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "换我我会\"不要\"——这一墩不值得搭牌。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "換我就「不要」——這一墩沒必要花牌去搶。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここは「過(パス)」だ――この場面で札を使う必要はない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저라면 여기선 패스합니다 — 이 한 판에 카드를 쓸 필요가 없어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Yo PASARÍA aquí: no hace falta gastar cartas en esta baza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moi je PASSERAIS ici : inutile de dépenser des cartes sur ce pli."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier würde ich PASSEN — keinen Grund, für diesen Stich Karten zu verbrennen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu PASSARIA aqui — não vale gastar cartas nessa rodada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь я бы ПАСОВАЛ — не стоит тратить карты на эту взятку."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كنت سأمرّر هنا — لا داعي لإنفاق أوراقك على هذه اللفّة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं यहाँ पास करूँगा — इस चाल पर पत्ते खर्च करने की ज़रूरत नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di sini saya akan LEWAT — tak perlu menghabiskan kartu untuk trik ini."
          }
        }
      }
    },
