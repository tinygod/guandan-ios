    "Usually ignore it — bomb or trapped either way": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通常别理它——反正不是炸弹就是被困死"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通常別管它——反正不是炸彈就是被困死"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "たいてい無視でいい——炸弾でも詰みでも、どっちみち同じ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보통은 무시 — 어차피 炸彈이거나 갇힌 신세"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalmente ignórala: bomba o atrapada de cualquier forma"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À ignorer en général — bombe ou piégé de toute façon"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meist ignorieren – Bombe oder gefangen, so oder so"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Geralmente ignore — bomba ou encurralado de qualquer jeito"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обычно не трогай — там либо бомба, либо ловушка"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجاهلها عادةً — قنبلة أو محاصرة في كلتا الحالتين"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आम तौर पर इसे छोड़ दो — चाहे बम हो या फँसा हुआ, दोनों ही हाल में"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biasanya abaikan saja — entah bom atau terjebak bagaimanapun juga"
          }
        }
      }
    },
