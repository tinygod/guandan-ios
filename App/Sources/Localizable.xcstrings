    "Fight the nine, not the ten": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "争9,别争10"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "爭那個9，別爭那個10"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "9とは戦い、10とは戦わない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "10이 아니라 9와 싸우세요"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelea el nueve, no el diez"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combattez le neuf, pas le dix"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kämpf um die Neun, nicht um die Zehn"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lute o nove, não o dez"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бейся за девятку, а не за десятку"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
