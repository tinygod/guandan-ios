    "And the 6s walk out unopposed. OUT — a flawless exit.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一串6无人能挡,顺势走出。走人——一次完美的离场。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "那些 6 暢通無阻地走了出去。出完——一次完美的脫手。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そして6が誰にも止められず出ていく。上がり――完璧な抜け方だ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그리고 6들이 막힘없이 빠져나간다. 아웃 — 완벽한 탈출."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Y los 6 salen sin oposición. FUERA: una salida impecable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Et les 6 sortent sans opposition. SORTI — une sortie sans faute."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Und die 6er marschieren ungehindert raus. RAUS — ein makelloser Abgang."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "E os 6 saem sem oposição. ACABOU — uma saída impecável."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "И шестёрки выходят без сопротивления. ВЫХОД — безупречная концовка."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وتخرج السِّتّات بلا منافس. انتهى — مخرج لا تشوبه شائبة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "और 6 बिना किसी विरोध के निकल जाते हैं। बाहर — एक बेदाग निकासी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dan kartu-kartu 6 melenggang tanpa perlawanan. KELUAR — jalan keluar yang sempurna."
          }
        }
      }
    },
    "And the 9 walks out last. First place!": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "那张9最后走出。头游!"
          }
