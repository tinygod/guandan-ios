    "Lena won't waste cards on a 4-pair…": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "莉娜才不会为一对4浪费牌……"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "蕾娜不會為了一對 4 浪費牌……"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レナは4の対子に札を無駄遣いしない…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레나는 4 페어에 카드를 낭비하지 않을 거예요…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lena no va a malgastar cartas en una pareja de 4..."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
