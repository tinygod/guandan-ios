    "Now the table is yours, and nothing big is left out there.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在牌桌归你了,外面也没什么大牌了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在牌桌歸你了，外面也沒有大牌剩下。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今や卓は君のものだ、そして大物はもう外に残っていない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 테이블은 당신 거고, 밖에 큰 건 아무것도 안 남았어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora la mesa es tuya, y no queda nada grande por ahí afuera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenant la table est à vous, et plus rien de gros ne traîne là-dehors."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt gehört der Tisch dir, und nichts Großes ist mehr da draußen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora a mesa é sua, e não sobrou nada grande por aí."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь стол твой, и ничего крупного там не осталось."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الآن الطاولة لك، ولم يتبقَّ هناك شيء كبير."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब टेबल आपकी है, और वहाँ कुछ भी बड़ा नहीं बचा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekarang meja jadi milikmu, dan tak ada kartu besar yang tersisa di luar sana."
          }
        }
      }
    },
    "Now the tiny pair — she holds no pairs, the lane is shut.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在出那个小对子——她手里没有对子,这条线关死了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在出那對小的——她手裡沒有對子，這條道封死了。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今度は小さな対子――彼女は対子を持っていない、レーンは閉じた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 작은 페어를 내세요 — 그녀는 페어가 없으니, 줄은 닫혔습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora la pareja diminuta: ella no tiene parejas, el carril está cerrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenant la petite paire — elle ne tient aucune paire, la voie est fermée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt das winzige Paar — sie hält keine Paare, die Spur ist dicht."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora o parzinho — ela não tem pares, a pista está fechada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь крошечная пара — у неё нет пар, дорожка закрыта."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الآن الزوج الصغير — هي لا تملك أزواجاً، المسار مغلق."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब वह नन्हा जोड़ा — उसके पास कोई जोड़ा नहीं है, लेन बंद हो गई।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekarang pasangan kecilnya — dia tak punya pasangan, jalurnya tertutup."
          }
        }
      }
    },
    "Now win the lead back — Ace!": {
