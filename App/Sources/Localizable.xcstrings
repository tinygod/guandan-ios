    "Cap to the top, answer fire with fire": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压到顶，以火攻火"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "壓到頂，以火攻火"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頂点まで重ね、火には火で応える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끝까지 눌러막고, 불에는 불로 맞서세요"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Topa hasta arriba, responde al fuego con fuego"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coiffez jusqu'au sommet, répondez au feu par le feu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deckle bis ganz nach oben, antworte auf Feuer mit Feuer"
          }
