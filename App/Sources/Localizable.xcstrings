    "Lena opens with a monster: a full house of Kings.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "莉娜开了一手猛货:三带二的K(三带二)。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "蕾娜開局甩出一手大牌：一副 K 的三帶二。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レナはモンスターで切り出す：Kの三帯二だ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레나가 괴물패로 시작합니다: 킹 세 장 짜리 삼대이."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lena abre con un monstruo: un trío con pareja de Reyes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lena ouvre avec un monstre : un three-and-two de Rois."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lena eröffnet mit einem Monster: einem Full House aus Königen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lena abre com um monstro: um três-com-dois de Reis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лена открывает монстром: тройка с двойкой на королях."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تفتتح لينا بوحش: ثلاثة مع اثنين من الملوك."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लीना एक राक्षस के साथ शुरुआत करती है: बादशाहों का तीन-दो (फुल हाउस)।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lena membuka dengan monster: tiga-bawa-dua berisi Raja."
          }
        }
      }
    },
    "Lena passes too. Coach Wu wins the trick and leads next.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "莉娜也不要。吴教练赢下这一墩,接着出牌。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "蕾娜也「不要」。吳教練贏下這一墩，由他接著出牌。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レナも過(パス)。教練呉がこの番を取り、次に首攻する。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레나도 패스합니다. 우 교练이 이 판을 이기고 다음을 냅니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lena también pasa. El Entrenador Wu gana la baza y sale a continuación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lena passe aussi. Le coach Wu remporte le pli et mène ensuite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lena passt ebenfalls. Coach Wu gewinnt den Stich und spielt als Nächster an."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lena também passa. O Treinador Wu vence a rodada e lidera a próxima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лена тоже пасует. Тренер У берёт взятку и ходит следующим."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمرّر لينا أيضاً. يفوز المدرب وو باللفّة ويقود تالياً."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लीना भी पास करती है। कोच वू यह चाल जीतता है और अगली बार चलता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lena ikut lewat. Coach Wu memenangkan trik dan memimpin berikutnya."
          }
        }
      }
    },
    "Lena passes. The Kings stand…": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "莉娜不要。那手K站住了……"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "蕾娜「不要」。這手 K 穩住了……"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レナは過(パス)。Kがそのまま通る…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레나가 패스합니다. 킹들이 그대로 통합니다…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lena pasa. Los Reyes aguantan..."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lena passe. Les Rois tiennent…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lena passt. Die Könige stehen …"
          }
        },
        "pt-BR": {
